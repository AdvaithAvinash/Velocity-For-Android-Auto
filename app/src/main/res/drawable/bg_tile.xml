<?xml version="1.0" encoding="utf-8"?>
<!-- Cars are mostly driven with a rotary dial or D-pad, not a finger, so the
     focused state needs to be as unmistakable as the pressed state. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:drawable="@drawable/shape_tile_focused" />
    <item android:state_pressed="true" android:drawable="@drawable/shape_tile_focused" />
    <item android:state_selected="true" android:drawable="@drawable/shape_tile_focused" />
    <item android:drawable="@drawable/shape_tile_normal" />
</selector>

<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#000000"
        app:animation_enabled="false"
        app:show_next_button="false"
        app:show_previous_button="false"
        app:show_shuffle_button="false"
        app:surface_type="texture_view"
        app:use_controller="true" />

    <ProgressBar
        android:id="@+id/loadingIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateTint="@color/accent" />

    <TextView
        android:id="@+id/errorMessage"
        style="@style/Velocity.Text.Subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/player_error"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/playerTopBar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="top"
        android:background="@color/scrim"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="@dimen/touch_target_min"
            android:layout_height="@dimen/touch_target_min"
            android:background="@drawable/bg_circle_button"
            android:contentDescription="@string/cd_back"
            android:padding="14dp"
            android:src="@drawable/ic_arrow_back"
            app:tint="@color/on_background" />

        <TextView
            android:id="@+id/playerTitle"
            style="@style/Velocity.Text.TileLabel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            tools:text="Video title" />

    </LinearLayout>

</FrameLayout>

<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- No motion-heavy Material transitions, no elevation-driven shadows to
         redraw every frame - the whole point is that it never feels "busy"
         while someone glances at it from the driver's seat. -->
    <style name="Theme.Velocity" parent="Theme.MaterialComponents.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">@color/background</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:navigationBarColor">@color/background</item>
        <item name="android:statusBarColor">@color/background</item>
        <item name="android:windowContentTransitions">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowIsTranslucent">false</item>
        <item name="android:datePickerDialogTheme" tools:targetApi="lollipop">@null</item>
    </style>

    <style name="Theme.Velocity.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentTransitions">false</item>
    </style>

    <!-- parent="" disables aapt2's dot-name implicit-parent lookup (it would
         otherwise look for a style literally named "Velocity.Text", which
         doesn't exist, and fail the resource link). -->
    <style name="Velocity.Text.Title" parent="">
        <item name="android:textColor">@color/on_background</item>
        <item name="android:textSize">28sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <style name="Velocity.Text.Subtitle" parent="">
        <item name="android:textColor">@color/on_background_muted</item>
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Velocity.Text.TileLabel" parent="">
        <item name="android:textColor">@color/on_background</item>
        <item name="android:textSize">18sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
</resources>
